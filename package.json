{
  "name": "whatsapp-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "vercel-build": "node scripts/migrate.mjs --if-configured && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@vercel/functions": "^3.10.3",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
