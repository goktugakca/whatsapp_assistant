# Claude (Anthropic API) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# İsteğe bağlı: model ve efor (varsayılan claude-haiku-5-5 / low)
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low
# Panelde fiyat listesi fotoğrafını okuyan model (tek seferlik, doğruluk önemli).
# ANTHROPIC_IMPORT_MODEL=claude-opus-5-5
# Fotoğrafla fiyat verirken örnekleri karşılaştıran model (yoksa ANTHROPIC_IMPORT_MODEL).
# ANTHROPIC_PHOTO_MODEL=claude-opus-5-5

# WhatsApp Cloud API — Meta for Developers > uygulamanız > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uygulama ayarları > Temel > Uygulama gizli anahtarı (webhook imzası için)
WHATSAPP_APP_SECRET=
# Webhook kaydederken sizin belirlediğiniz rastgele bir metin
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0

# Instagram mesajları — Meta uygulamanızda "Instagram" ürünü > API setup with Instagram login
# (Instagram app ID / Instagram app secret). Hesap panelden "Instagram'ı bağla" ile bağlanır.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Webhook doğrulama metni (yoksa WHATSAPP_VERIFY_TOKEN kullanılır)
# INSTAGRAM_VERIFY_TOKEN=
# Veritabanındaki Instagram erişim anahtarlarını şifreleyen gizli metin (yoksa SESSION_SECRET/PANEL_PASSWORD)
# INSTAGRAM_TOKEN_KEY=

# Postgres (Neon, Supabase vb.). Tanımlı değilse veriler bellekte tutulur ve yeniden başlatmada silinir.
# Sunucusuz ortamda havuzlanmış (pooled) bağlantı adresini kullanın. Şema: npm run db:migrate
DATABASE_URL=

# Yönetici şifresi: /giris sayfasında kullanıcı adı "admin" ile. Production'da zorunlu.
PANEL_PASSWORD=

# Herkese açık ortamda demo sohbeti kapatmak için false yapın (API maliyeti)
# DEMO_ENABLED=true

# WhatsApp numarasının bağlı olduğu işletme (lib/businesses içindeki id). Varsayılan: demo-kuafor
# WHATSAPP_BUSINESS_ID=demo-kuafor

# İsteğe bağlı: WhatsApp mesajlarındaki randevu bağlantıları için uygulamanın adresi.
# Vercel'de gerekmez (VERCEL_PROJECT_PRODUCTION_URL kullanılır).
# APP_URL=https://randevu.ornek.com
# Gizlilik politikası sayfasında (/gizlilik) gösterilen iletişim adresi.
# CONTACT_EMAIL=iletisim@ornek.com
# İsteğe bağlı: takvim abonelik linkinin anahtarı. Yoksa PANEL_PASSWORD'den türetilir.
# CALENDAR_FEED_SECRET=

# Randevu hatırlatma (bkz. README "Randevu hatırlatmaları"): Meta'da onaylı şablon adı ve cron sırrı
# WHATSAPP_REMINDER_TEMPLATE=randevu_hatirlatma
# WHATSAPP_REMINDER_LANGUAGE=tr
# CRON_SECRET=

# İsteğe bağlı: panel oturum çerezinin imza anahtarı. Yoksa PANEL_PASSWORD kullanılır.
# SESSION_SECRET=
