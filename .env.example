# Claude (Anthropic API) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# İsteğe bağlı: model ve efor (varsayılan claude-opus-5-5 / low)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# WhatsApp Cloud API — Meta for Developers > uygulamanız > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Uygulama ayarları > Temel > Uygulama gizli anahtarı (webhook imzası için)
WHATSAPP_APP_SECRET=
# Webhook kaydederken sizin belirlediğiniz rastgele bir metin
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0

# İşletme paneli parolası (/panel). Production'da zorunlu.
PANEL_PASSWORD=

# Herkese açık ortamda demo sohbeti kapatmak için false yapın (API maliyeti)
# DEMO_ENABLED=true

# WhatsApp numarasının bağlı olduğu işletme (lib/businesses içindeki id). Varsayılan: demo-kuafor
# WHATSAPP_BUSINESS_ID=demo-kuafor
